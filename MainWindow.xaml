<Window x:Class="XenoHardwareMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Monitor" Height="520" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border Background="#171a21" BorderBrush="#3d4450" BorderThickness="1" CornerRadius="4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="28"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="22"/>
      </Grid.RowDefinitions>
      
      <!-- Steam TitleBar -->
      <Grid Grid.Row="0" Background="#0f1419">
        <TextBlock Text="Hardware Monitor" 
                  Foreground="#c7d5e0" 
                  FontWeight="Bold" 
                  FontSize="11" 
                  Margin="8,0,0,0" 
                  VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="-" Width="28" Height="28" 
                  Background="Transparent" Foreground="#8f98a0" 
                  BorderThickness="0" Click="BtnMinimize_Click"
                  Cursor="Hand"/>
          <Button Content="[]" Width="28" Height="28" 
                  Background="Transparent" Foreground="#8f98a0" 
                  BorderThickness="0" Click="BtnMaximize_Click"
                  Cursor="Hand"/>
          <Button Content="X" Width="28" Height="28" 
                  Background="Transparent" Foreground="#8f98a0" 
                  BorderThickness="0" Click="BtnClose_Click"
                  Cursor="Hand"/>
        </StackPanel>
      </Grid>

      <!-- Main Data-Dense Grid (6 Modules) -->
      <UniformGrid Grid.Row="1" Rows="3" Columns="2" Margin="6">
        
        <!-- CPU Card -->
        <Border Background="#1b2838" BorderBrush="#3d4450" BorderThickness="1" Margin="3" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Left Data Sidebar -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock Text="CPU MODULE" Foreground="#00E5FF" FontWeight="Bold" FontSize="13"/>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="USE" Foreground="#8f98a0" FontSize="9"/><TextBlock x:Name="TxtCpuUsage" Text="--%" FontSize="18" FontWeight="SemiBold" Foreground="#c7d5e0"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="TEMP" Foreground="#8f98a0" FontSize="9"/><TextBlock x:Name="TxtCpuTemp" Text="--C" FontSize="13" FontWeight="SemiBold" Foreground="#FF9100"/></StackPanel>
              </Grid>
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="CLOCK SPEED" Foreground="#8f98a0" FontSize="9"/>
                <TextBlock x:Name="TxtCpuClock" Text="-- GHz" FontSize="13" FontWeight="SemiBold" Foreground="#00E676"/>
              </StackPanel>
            </StackPanel>
            <!-- Right Grid Graph Area -->
            <Grid Grid.Column="1" Background="#232933" Margin="2,0,0,0">
              <Path x:Name="PathCpuGhost" Stroke="#ffffff" StrokeThickness="1" Opacity="0.25" StrokeDashArray="2 2" Data="" Stretch="Fill"/>
              <Path x:Name="PathCpu" Stroke="#00E5FF" StrokeThickness="3" Fill="{StaticResource CpuGradient}" Data="" Stretch="Fill">
                <Path.Effect>
                  <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                </Path.Effect>
              </Path>
            </Grid>
          </Grid>
        </Border>

        <!-- GPU Card -->
        <Border Background="#1b2838" BorderBrush="#3d4450" BorderThickness="1" Margin="3" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock x:Name="TxtGpuName" Text="GPU" Foreground="#FF9100" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="USE" Foreground="#8f98a0" FontSize="9"/><TextBlock x:Name="TxtGpuUsage" Text="--%" FontSize="18" FontWeight="SemiBold" Foreground="#c7d5e0"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="TEMP" Foreground="#8f98a0" FontSize="9"/><TextBlock x:Name="TxtGpuTemp" Text="--C" FontSize="13" FontWeight="SemiBold" Foreground="#FF9100"/></StackPanel>
              </Grid>
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="VRAM USED" Foreground="#8f98a0" FontSize="9"/>
                <TextBlock x:Name="TxtGpuVram" Text="-- / -- GB" FontSize="11" FontWeight="SemiBold" Foreground="#00E676"/>
              </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" Background="#232933" Margin="2,0,0,0">
              <Path x:Name="PathGpuGhost" Stroke="#ffffff" StrokeThickness="1" Opacity="0.25" StrokeDashArray="2 2" Data="" Stretch="Fill"/>
              <Path x:Name="PathGpu" Stroke="#FF9100" StrokeThickness="3" Fill="{StaticResource GpuGradient}" Data="" Stretch="Fill">
                <Path.Effect>
                  <DropShadowEffect Color="#FF9100" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                </Path.Effect>
              </Path>
            </Grid>
          </Grid>
        </Border>

        <!-- MEMORY -->
        <Border Background="#1b2838" BorderBrush="#3d4450" BorderThickness="1" Margin="3" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock Text="MEMORY" Foreground="#00E676" FontWeight="Bold" FontSize="13"/>
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="RAM USED" Foreground="#8f98a0" FontSize="9"/>
                <TextBlock x:Name="TxtRamUsed" Text="-- / -- GB" FontSize="14" FontWeight="SemiBold" Foreground="#00E676"/>
              </StackPanel>
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="USAGE PCT" Foreground="#8f98a0" FontSize="9"/>
                <TextBlock x:Name="TxtRamPercent" Text="--%" FontSize="16" FontWeight="SemiBold" Foreground="#c7d5e0"/>
              </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" Background="#232933" Margin="2,0,0,0">
              <Path x:Name="PathRamGhost" Stroke="#ffffff" StrokeThickness="1" Opacity="0.25" StrokeDashArray="2 2" Data="" Stretch="Fill"/>
              <Path x:Name="PathRam" Stroke="#00E676" StrokeThickness="3" Fill="{StaticResource RamGradient}" Data="" Stretch="Fill">
                <Path.Effect>
                  <DropShadowEffect Color="#00E676" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                </Path.Effect>
              </Path>
            </Grid>
          </Grid>
        </Border>

        <!-- STORAGE -->
        <Border Background="#1b2838" BorderBrush="#3d4450" BorderThickness="1" Margin="3" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock Text="STORAGE" Foreground="#FFEE58" FontWeight="Bold" FontSize="13"/>
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="DISK ACTIVE" Foreground="#8f98a0" FontSize="9"/>
                <TextBlock x:Name="TxtDiskActivity" Text="--%" FontSize="18" FontWeight="SemiBold" Foreground="#FFEE58"/>
              </StackPanel>
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="DRIVE FREE" Foreground="#8f98a0" FontSize="9"/>
                <TextBlock x:Name="TxtDiskFree" Text="-- GB" FontSize="11" FontWeight="SemiBold" Foreground="#c7d5e0"/>
              </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" Background="#232933" Margin="2,0,0,0">
              <Path x:Name="PathStorageGhost" Stroke="#ffffff" StrokeThickness="1" Opacity="0.25" StrokeDashArray="2 2" Data="" Stretch="Fill"/>
              <Path x:Name="PathStorage" Stroke="#FFEE58" StrokeThickness="3" Fill="{StaticResource StorageGradient}" Data="" Stretch="Fill">
                <Path.Effect>
                  <DropShadowEffect Color="#FFEE58" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                </Path.Effect>
              </Path>
            </Grid>
          </Grid>
        </Border>

        <!-- NETWORK -->
        <Border Background="#1b2838" BorderBrush="#3d4450" BorderThickness="1" Margin="3" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock Text="NETWORK" Foreground="#AB47BC" FontWeight="Bold" FontSize="13"/>
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="THROUGHPUT" Foreground="#8f98a0" FontSize="9"/>
                <TextBlock x:Name="TxtNetworkSpeed" Text="--K" FontSize="18" FontWeight="SemiBold" Foreground="#AB47BC"/>
              </StackPanel>
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="STATUS" Foreground="#8f98a0" FontSize="9"/>
                <TextBlock x:Name="TxtNetStatus" Text="--/--" FontSize="11" FontWeight="SemiBold" Foreground="#c7d5e0"/>
              </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" Background="#232933" Margin="2,0,0,0">
              <Path x:Name="PathNetworkGhost" Stroke="#ffffff" StrokeThickness="1" Opacity="0.25" StrokeDashArray="2 2" Data="" Stretch="Fill"/>
              <Path x:Name="PathNetwork" Stroke="#AB47BC" StrokeThickness="3" Fill="{StaticResource NetworkGradient}" Data="" Stretch="Fill">
                <Path.Effect>
                  <DropShadowEffect Color="#AB47BC" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                </Path.Effect>
              </Path>
            </Grid>
          </Grid>
        </Border>

        <!-- SYSTEM -->
        <Border Background="#1b2838" BorderBrush="#3d4450" BorderThickness="1" Margin="3" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock Text="SYSTEM" Foreground="#26A69A" FontWeight="Bold" FontSize="13"/>
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="UPTIME" Foreground="#8f98a0" FontSize="9"/>
                <TextBlock x:Name="TxtUptime" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="#c7d5e0"/>
              </StackPanel>
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="PROCESSES" Foreground="#8f98a0" FontSize="9"/>
                <TextBlock x:Name="TxtProcessCount" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="#26A69A"/>
              </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" Background="#232933" Margin="2,0,0,0">
              <Path x:Name="PathSystemGhost" Stroke="#ffffff" StrokeThickness="1" Opacity="0.25" StrokeDashArray="2 2" Data="" Stretch="Fill"/>
              <Path x:Name="PathSystem" Stroke="#26A69A" StrokeThickness="3" Fill="{StaticResource SystemGradient}" Data="" Stretch="Fill">
                <Path.Effect>
                  <DropShadowEffect Color="#26A69A" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                </Path.Effect>
              </Path>
            </Grid>
          </Grid>
        </Border>

      </UniformGrid>

      <!-- Status Bar -->
      <Grid Grid.Row="2" Background="#111827">
        <TextBlock Text="STATUS: MONITORING ACTIVE" FontSize="9" Foreground="#64748b" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Border>
</Window>